{
  "info": {
    "_postman_id": "338fe182-f33e-4eb5-93ed-c013bd929a0c",
    "name": "AI 工单助手",
    "description": "按编号依次运行。登录后自动保存 token，创建工单后自动保存 ticketId。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 登录",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.token) { pm.collectionVariables.set('token', body.data.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "02 创建工单",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.id) { pm.collectionVariables.set('ticketId', String(body.data.id)); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"投影仪连不上\",\n  \"description\": \"3 号实验室 HDMI 无信号\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tickets"]
        }
      }
    },
    {
      "name": "03 查询工单",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tickets"]
        }
      }
    },
    {
      "name": "04 修改状态",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toStatus\": \"PROCESSING\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tickets", "{{ticketId}}", "status"]
        }
      }
    },
    {
      "name": "05 AI 分类",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/ai",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tickets", "{{ticketId}}", "ai"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "ticketId", "value": "1", "type": "string" }
  ]
}

